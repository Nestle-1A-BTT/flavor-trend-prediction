   "metadata": {},
   "outputs": [],
   "source": [
    "file_pattern = 'top_data/**/*.parquet' \n",
    "parquet_files = glob.glob(file_pattern, recursive=True)\n",
    " \n",
    "# Reads each parquet file and concatenate them into a single DataFrame\n",
    "df = pd.concat([pd.read_parquet(fp) for fp in parquet_files], ignore_index=True)"
   ]
